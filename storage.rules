rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile images
    match /profile-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Employee images: idCards, photo3x4, criminalRecords, declarations, profiles
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Documents
    match /doc/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Leave request attachments
    match /leaves/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Work outside request attachments
    match /workOutside/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Attendance photos
    match /attendance/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

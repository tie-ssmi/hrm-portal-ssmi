rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // attendance photos — authenticated employees only
    match /attendance/{userUuid}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // leave documents — authenticated employees only
    match /leaves/{userUuid}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // profile images — authenticated employees only, owner writes
    match /profile-images/{userUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userUid;
    }

    // block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}